# 복사해서 .env 로 저장하고 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# ── 원장 ──
OWNER_NAME=원장님
ACADEMY_NAME=OO학원

# ── 텔레그램 (2단계) ──
# @BotFather 에서 만든 봇 토큰. Claude 텔레그램 플러그인이 씁니다.
TELEGRAM_BOT_TOKEN=
# 원장 본인의 chat_id (봇에 아무 말이나 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 확인)
TELEGRAM_CHAT_ID=

# ── 폰 → 서버 수신함 (4단계) ──
# 폰(MacroDroid)이 서버에 보낼 때 붙이는 비밀 토큰. 아무 긴 문자열이나: openssl rand -hex 24
INBOX_TOKEN=
# 서버가 듣는 포트. 공개는 cloudflared 같은 터널로만 하고, 서버 자체는 127.0.0.1 에 묶습니다.
INBOX_PORT=8787

# ── 문자 발송 (5단계, 솔라피) ──
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록·인증한 발신번호 (숫자만)
SOLAPI_FROM=

# ── 선택: 통화·음성메모 전사 (없으면 문자만 받습니다) ──
SONIOX_API_KEY=
